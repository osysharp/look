namespace Osysharp.Look;

// The board's dropdown over rows of an entity (Components §22, as `LookEnumSelect` draws it): the field frame closed, the
// list open under it — and, once the rows are more than a handful, a search box at the list's head that the PAGE's query
// answers. The page reads one page of rows (`.Take(n)`), keyed on the text typed; nothing reads the whole table.

/// A choice of one row: `value` a two-way `Binding<T>` (`T?` for an optional one), `options` the page's ONE PAGE of rows
/// keyed on `search` — `live var hosts = Host.Where(h => h.Name.Contains(find)).OrderBy(h => h.Name).Take(20).ToList();` —
/// and `words` what a row reads as. The search box shows at the list's head once there are `searchFrom` rows or more
/// (8), or a search is typed; it says "Nothing matches" and, past one answer, "More match — keep typing". `label` is drawn
/// 13/600 above it and is its name (`inRow`: a `FieldRow` draws it), `placeholder` what the box says with no row chosen,
/// `help` a 12 px Ink 3 line under it. The keyboard: ↓/↑ open it and move, Enter picks, Escape closes; with the search
/// box, typing filters and ↓/↑/Enter still move and pick. `onChanged` runs after the choice is written.
/// `console`: the console's form control (as `ConsoleInput` beside it) — the 30 px face on a desktop (44 on a phone), its label
/// 12.5/500 in the console's text colour and `help` 12 px in its text-2, as `ConsoleField` draws them.
/// In a test: `Ui.Click("Host")`, `Ui.Fill("Search Host", "kes")`, `Ui.Click("Kestrel")`.
[Composable]
component LookRefPicker<T>(string label, Binding<T> value, Binding<string> search, T[] options, Func<T, string> words, string placeholder = "",
                           string w = "100%", string help = "", bool inRow = false, bool disabled = false, int searchFrom = 8,
                           Action? onChanged = null, bool console = false) {
  bool open = false;
  int at = 0;
  bool back = false;

  bool Searching() { return search != "" || options.Count >= searchFrom; }
  int IndexOf(T m) {
    int i = 0;
    int found = 0;
    foreach (var o in options) {
      if (o == m) { found = i; }
      i = i + 1;
    }
    return found;
  }
  action OpenAtValue() {
    at = IndexOf(value);
    back = false;
    open = true;
  }
  action Toggle() {
    if (open) {
      Close();
    } else {
      OpenAtValue();
    }
  }
  // Closed by a key or a choice: the keyboard goes back to the box. Closed by a press elsewhere: it stays there.
  action Close() { open = false; back = true; }
  action Dismiss() { open = false; }
  action Choose(T m) {
    value = m;
    open = false;
    back = true;
    if (onChanged != null) { onChanged(); }
  }
  action ChooseAt() {
    int i = 0;
    T picked = value;
    foreach (var m in options) {
      if (i == at) { picked = m; }
      i = i + 1;
    }
    if (options.Count > 0) { Choose(picked); } else { Close(); }
  }
  action Typed() { at = 0; }
  action Move(string key) {
    if (key == "Down") {
      if (at < options.Count - 1) { at = at + 1; }
    } else if (key == "Up") {
      if (at > 0) { at = at - 1; }
    } else if (key == "Home") {
      at = 0;
    } else if (key == "End") {
      at = options.Count - 1;
    } else if (key == "Enter" || key == "Space") {
      ChooseAt();
    }
  }
  action BoxKey(string name) {
    var key = name.Replace("Arrow", "");
    if (key == "Escape") {
      open = false;
    } else if (!open) {
      if (key == "Down" || key == "Up" || key == "Enter" || key == "Space") { OpenAtValue(); }
    } else {
      Move(key);
    }
  }
  action SearchKey(string name) { Move(name.Replace("Arrow", "")); }

  render {
    var desk = console && Viewport.AtLeast(Tablet);
    Stack(gap: "6px", w: w, maxW: "100%", minW: "0") {
      if (!inRow && console) {
        Text(label, fontSize: FontSize.ConsoleControl, fontWeight: 500, color: Colors.ConsoleText, lineHeight: "1.3", fontFamily: Font.ConsoleSans, decorative: true);
      } else if (!inRow) {
        Text(label, fontSize: FontSize.Label, fontWeight: FontWeight.Semibold, color: Colors.OnSurface, lineHeight: "normal", decorative: true);
      }
      Box(position: Position.Relative, w: "100%") {
        Pressable(onClick: Toggle, disabled: disabled, role: UiRole.ComboBox, expanded: open, label: label, autoFocus: back,
                  keys: [Up, Down, Enter, Space, Escape, Home, End], onKeyDown: BoxKey, w: "100%") {
          LookSelectFace(open, disabled, console: desk, consoleOpen: desk && open) {
            if (value == null) {
              Text(placeholder, grow: 1, minW: "0", color: Colors.Ink3, overflow: Overflow.Hidden, textOverflow: TextOverflow.Ellipsis,
                   whiteSpace: WhiteSpace.Nowrap, textAlign: TextAlign.Left);
            } else {
              Text(words(value), grow: 1, minW: "0", overflow: Overflow.Hidden, textOverflow: TextOverflow.Ellipsis, whiteSpace: WhiteSpace.Nowrap,
                   textAlign: TextAlign.Left);
            }
            Text("▾", color: Colors.Ink3, shrink: 0, decorative: true);
          }
        }
        if (open) {
          Backdrop(Dismiss);
          Stack(position: Position.Absolute, top: "100%", left: "0", right: "0", mt: "4px", z: ZIndex.Popover, bg: Colors.Surface,
                borderW: 1, border: Colors.ControlLine, rounded: Radius.Control, shadow: Shadow.DrawerLift, p: "4px", gap: "4px") {
            if (Searching()) {
              Input(value: search, label: "Search " + label, placeholder: "Type to search", type: "search", autoFocus: true, w: "100%", h: "36px",
                    px: "10px", fontSize: FontSize.Body, fontWeight: FontWeight.Regular, fontFamily: Font.Sans, color: Colors.OnSurface,
                    bg: Colors.Surface, rounded: Radius.Tag, borderW: 1, border: Colors.ControlLine, onInput: Typed, onEscape: Close,
                    keys: [Up, Down, Enter], onKeyDown: SearchKey);
            }
            Stack(role: UiRole.ListBox, gap: 0, maxH: "320px", overflowY: Overflow.Auto) {
              foreach (var m in options) {
                Pressable(onClick: () => Choose(m), w: "100%") {
                  LookSelectRow(words(m), m == value, IndexOf(m) == at);
                }
              }
            }
            if (options.Count == 0) {
              Text("Nothing matches “" + search.Trim() + "”.", fontSize: FontSize.Body, color: Colors.Ink3, p: "8px");
            }
            if (options.HasMore) {
              Text("More match — keep typing to narrow it.", fontSize: FontSize.Caption, color: Colors.Ink3, px: "8px", py: "4px");
            }
          }
        }
      }
      if (help != "" && console) {
        Text(help, fontSize: FontSize.ConsoleSmall, color: Colors.ConsoleText2, lineHeight: "1.4", fontFamily: Font.ConsoleSans);
      } else if (help != "") {
        Text(help, fontSize: FontSize.Caption, color: Colors.Ink3, lineHeight: "normal");
      }
    }
  }
}
