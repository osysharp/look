namespace Osysharp.Look;

/// The six tones of a message or a gauge: the five status tones and `Neutral`, the floor's grey (nothing wrong, nothing
/// started). The same values as `StatTone` without its `None`; kept apart so `StatTile`'s file stays its own.
public enum LookTone { Ok, Run, Wait, You, Bad, Neutral }

/// A tone's dot, 7 px round in its dot colour (as the status chip's). Decorative: the words beside it say it.
[Composable]
component LookToneDot(LookTone tone) {
  variants {
    base {
      W = "7px";
      H = "7px";
      MinW = "7px";
      Rounded = Radius.Pill;
    }
    tone {
      Ok { Bg = Colors.OkDot; }
      Run { Bg = Colors.RunDot; }
      Wait { Bg = Colors.WaitDot; }
      You { Bg = Colors.YouDot; }
      Bad { Bg = Colors.BadDot; }
      Neutral { Bg = Colors.FloorDot; }
    }
  }
  render { Box(decorative: true); }
}
