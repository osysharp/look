namespace Osysharp.Look;

// The board's dropdown (Components §22 "Dropdown, open"): the field frame closed — 44 high, `0 12px`, radius 8, the
// control line, 14/400 Ink, a ▾ in Ink 3 — and while open the 2 px accent line (`0 11px`) with its list under it: as
// wide as the field, 4 px below, white in the control line, radius 8, the menu's lift (`0 10px 24px`), `4px` round its
// rows; a row 14/400 `8px`, radius 6, the chosen one with the accent ink's ✓, the one under the pointer or the keyboard
// on Line 2. The browser's select cannot be drawn so; `LookSelect` is the same dropdown over strings and `LookRefPicker`
// over rows.

/// A select bound to an enum: `value` a two-way `Binding<T>`, its rows `options` (every member by default), each worded by
/// its `[Label]`. `label` is drawn 13/600 above it and is its name (`inRow`: a `FieldRow` draws it); `help` a 12 px Ink 3
/// line under it; `w` its width (the field's column by default). The keyboard: ↓/↑ open it and move, Enter picks, Escape
/// closes; a press outside closes it. `onChanged` runs after the choice is written (a page that re-reads the server).
/// `console`: the console's form control (as `ConsoleInput` beside it) — the 30 px face on a desktop (44 on a phone), its label
/// 12.5/500 in the console's text colour and `help` 12 px in its text-2, as `ConsoleField` draws them.
/// In a test: `Ui.Click("Runs when")`, `Ui.Press("ArrowDown")`, `Ui.Press("Enter")`, `Assert.Value(…)` or the words.
[Composable]
component LookEnumSelect<T>(string label, Binding<T> value, T[] options = T.Members, string w = "100%", string help = "", bool inRow = false,
                            bool disabled = false, Action? onChanged = null, bool console = false) {
  bool open = false;
  int at = 0;

  action Toggle() {
    if (open) {
      open = false;
    } else {
      OpenAtValue();
    }
  }
  action Close() { open = false; }
  int IndexOf(T m) {
    int i = 0;
    int found = 0;
    foreach (var o in options) {
      if (o == m) { found = i; }
      i = i + 1;
    }
    return found;
  }
  action OpenAtValue() {
    at = IndexOf(value);
    open = true;
  }
  action Choose(T m) {
    value = m;
    open = false;
    if (onChanged != null) { onChanged(); }
  }
  action ChooseAt() {
    int i = 0;
    foreach (var m in options) {
      if (i == at) {
        value = m;
      }
      i = i + 1;
    }
    open = false;
    if (onChanged != null) { onChanged(); }
  }
  action Key(string name) {
    // The key surface hands the key's name ("Down"); a browser's own name ("ArrowDown") is read the same.
    var key = name.Replace("Arrow", "");
    if (key == "Escape") {
      open = false;
    } else if (!open) {
      if (key == "Down" || key == "Up" || key == "Enter" || key == "Space") { OpenAtValue(); }
    } else if (key == "Down") {
      if (at < options.Count - 1) { at = at + 1; }
    } else if (key == "Up") {
      if (at > 0) { at = at - 1; }
    } else if (key == "Home") {
      at = 0;
    } else if (key == "End") {
      at = options.Count - 1;
    } else if (key == "Enter" || key == "Space") {
      ChooseAt();
    }
  }

  render {
    var desk = console && Viewport.AtLeast(Tablet);
    Stack(gap: "6px", w: w, maxW: "100%", minW: "0") {
      if (!inRow && console) {
        Text(label, fontSize: FontSize.ConsoleControl, fontWeight: 500, color: Colors.ConsoleText, lineHeight: "1.3", fontFamily: Font.ConsoleSans, decorative: true);
      } else if (!inRow) {
        Text(label, fontSize: FontSize.Label, fontWeight: FontWeight.Semibold, color: Colors.OnSurface, lineHeight: "normal", decorative: true);
      }
      Box(position: Position.Relative, w: "100%") {
        Pressable(onClick: Toggle, disabled: disabled, role: UiRole.ComboBox, expanded: open, label: label, keys: [Up, Down, Enter, Space, Escape, Home, End],
                  onKeyDown: Key, w: "100%") {
          LookSelectFace(open, disabled, console: desk, consoleOpen: desk && open) {
            Text(value.Label, grow: 1, minW: "0", overflow: Overflow.Hidden, textOverflow: TextOverflow.Ellipsis, whiteSpace: WhiteSpace.Nowrap,
                 textAlign: TextAlign.Left);
            Text("▾", color: Colors.Ink3, shrink: 0, decorative: true);
          }
        }
        if (open) {
          Backdrop(Close);
          Stack(role: UiRole.ListBox, position: Position.Absolute, top: "100%", left: "0", right: "0", mt: "4px", z: ZIndex.Popover, bg: Colors.Surface,
                borderW: 1, border: Colors.ControlLine, rounded: Radius.Control, shadow: Shadow.DrawerLift, p: "4px", gap: 0) {
            foreach (var m in options) {
              Pressable(onClick: () => Choose(m), w: "100%") {
                LookSelectRow(m.Label, m == value, IndexOf(m) == at);
              }
            }
          }
        }
      }
      if (help != "" && console) {
        Text(help, fontSize: FontSize.ConsoleSmall, color: Colors.ConsoleText2, lineHeight: "1.4", fontFamily: Font.ConsoleSans);
      } else if (help != "") {
        Text(help, fontSize: FontSize.Caption, color: Colors.Ink3, lineHeight: "normal");
      }
    }
  }
}
