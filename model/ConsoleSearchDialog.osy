namespace Osysharp.Look;

/// The console's search dialog over a dimmed page: one input, and under it the `groups` the page found for the typed
/// `text`, each under its heading. Results show after two characters. ↓ and ↑ move through all of them, Enter opens the
/// one marked, Escape or a press outside closes it. The page reads its results from `text`; this part reads nothing.
/// `label` names the field (Foundry: "Search Foundry"), `placeholder` is its hint (Foundry: "Search products, plan items
/// and hosts"); the app gives them in `ConsoleChrome.SearchLabel` and `SearchPlaceholder`.
[Composable]
component ConsoleSearchDialog(Binding<string> text, List<ConsoleSearchGroup> groups, Action onClose, string label = "Search",
                              string placeholder = "Search") {
  int at = 0;

  List<ConsoleSearchResult> All() {
    var all = new List<ConsoleSearchResult>();
    foreach (var group in groups) {
      all.AddRange(group.Results);
    }
    return all;
  }

  /// How many results come before the group at `index`.
  int Before(int index) {
    var count = 0;
    foreach (var number in Enumerable.Range(0, index)) {
      count = count + groups[number].Results.Count();
    }
    return count;
  }

  int Marked() => at < All().Count() ? at : 0;

  action Choose(ConsoleSearchResult result) {
    Navigation.Go(result.To);
    onClose();
  }

  action Key(string name) {
    var key = name.Replace("Arrow", "");
    if (key == "Down" && at < All().Count() - 1) {
      at = Marked() + 1;
    } else if (key == "Up" && Marked() > 0) {
      at = Marked() - 1;
    } else if (key == "Enter" && All().Count() > 0) {
      Choose(All()[Marked()]);
    }
  }

  render {
    var wide = Viewport.AtLeast(Tablet);
    var typed = text.Trim().Length >= 2;
    Box {
      Scrim(onClose);
      Stack(gap: 0, position: Position.Fixed, top: wide ? "12vh" : "8px", left: wide ? "calc(50% - 280px)" : "8px", right: wide ? "auto" : "8px",
            w: wide ? "560px" : "auto", maxH: "76vh", z: ZIndex.Modal, bg: Colors.ConsoleSurface, borderW: 1, border: Colors.ConsoleBorder,
            rounded: Radius.ConsoleCorner, overflow: Overflow.Hidden, color: Colors.ConsoleText, fontFamily: Font.ConsoleSans,
            role: UiRole.Dialog, label: "Search", onEscape: onClose, keys: [Up, Down, Enter], onKeyDown: Key) {
        Input(value: text, label: label, placeholder: placeholder, w: "100%", minH: "48px", px: "16px",
              fontSize: FontSize.ConsoleBody, bg: Colors.ConsoleSurface, borderBW: 1, border: Colors.ConsoleBorderInner);
        Stack(gap: 0, overflowY: Overflow.Auto, minW: "0", label: "Search results") {
          if (!typed) {
            Text("Type at least two characters.", p: "16px", color: Colors.ConsoleText2);
          } else if (All().Count() == 0) {
            Text("Nothing found for “" + text.Trim() + "”.", p: "16px", color: Colors.ConsoleText2);
          } else {
            foreach (var number in Enumerable.Range(0, groups.Count())) {
              if (groups[number].Results.Count() > 0) {
                Stack(gap: 0, role: UiRole.Region, label: groups[number].Label) {
                  Text(groups[number].Label, role: UiRole.Heading, level: 2, pt: "12px", px: "16px", pb: "4px", fontSize: FontSize.ConsoleBadge,
                       fontWeight: 600, color: Colors.ConsoleText2);
                  foreach (var index in Enumerable.Range(0, groups[number].Results.Count())) {
                    ConsoleSearchRow(groups[number].Results[index], Before(number) + index == Marked(), onClose);
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
