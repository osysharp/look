namespace Osysharp.Look;

/// Nothing here yet, inside a `ConsolePanel` (its body): `28px 16px`, centred, the `title` 13/600, `body` under it

/// (13, text-2, at most 440 wide), and the default slot 12 below for the one way on (a `ConsoleButton` or

/// A panel's body while it loads: `rows` skeleton rows (`14px 16px`, a row rule between), each a bar of the neutral

/// ground, radius 4, its width stepping 72 %, 56 %, 64 % so it reads as rows of words. A status named "Loading <what>",

/// What could not load, inside a panel (its body): `16px`, the critical icon, the `title` 13/600 in the critical ink,

/// `body` (13, text-2: why, and what still holds), and the default slot under it for the ways out (`ConsoleLink`s:

/// What the reader may not change here and whom to ask: the sunken ground, a 1 px border, radius 6, `10px 14px`, a

/// lock in text-3, the `words` (13, text-2; "You can view this policy. To change it, ask an org admin.") and the

/// A whole-page state in the console's working area (inside `ConsoleWork`, under the page's head): a panel at most 520

/// wide, 48 px down, centred, `20px 22px`; the kind's word (11.5/600: "Not found" · "No access" · "Error" in the

/// critical ink · "Offline"), the `title` (the page's h1, 18/600; 20 on a phone), `text` (13/1.5, text-2: what

/// happened and what still holds), and the default slot 6 below for its one way on. The region is named by the title;

/// an error and offline are alerts.
[Composable]
component ConsolePageState(PageStateKind kind, string title, string text) {
  render {
    var phone = !Layout.AtLeast(Tablet);
    Box(w: "100%", pt: phone ? "16px" : "48px", minW: "0") {
      Stack(gap: "8px", w: "100%", maxW: "520px", mx: "auto", py: "20px", px: "22px", minW: "0", bg: Colors.ConsoleSurface, borderW: 1,
            border: kind == PageStateKind.Error ? Colors.ConsoleCriticalLine : Colors.ConsoleBorder, rounded: Radius.ConsoleCorner,
            fontFamily: Font.ConsoleSans, role: kind == PageStateKind.Error || kind == PageStateKind.Offline ? UiRole.Alert : UiRole.Region,
            label: title) {
        Text(ConsoleStateWord(kind), fontSize: FontSize.ConsoleBadge, fontWeight: 600,
             color: kind == PageStateKind.Error ? Colors.ConsoleCriticalInk : Colors.ConsoleText2);
        Text(title, role: UiRole.Heading, level: 1, fontSize: phone ? FontSize.ConsoleTitlePhone : FontSize.ConsoleTitle, fontWeight: 600,
             lineHeight: "1.3", color: Colors.ConsoleText);
        Text(text, fontSize: phone ? FontSize.ConsoleBodyPhone : FontSize.ConsoleBody, lineHeight: "1.5", color: Colors.ConsoleText2);
        Row(gap: "8px", wrap: Wrapping.Wrap, mt: "6px") { Slot; }
      }
    }
  }
}


/// The word a page state is headed by.
string ConsoleStateWord(PageStateKind kind) => kind == PageStateKind.NotFound ? "Not found"
  : (kind == PageStateKind.Forbidden ? "No access" : (kind == PageStateKind.Error ? "Error" : "Offline"));
