namespace Osysharp.Look;

/// A diff of lines (Components §6 "Diff"): JetBrains Mono 13/1.7 in a box on the soft line, radius 8; each line `2px 10px`.
/// A line written "+ …" is added (ok tint and ink), "− …" or "- …" removed (bad tint and ink), any other line unchanged —
/// write it with two spaces in front so the columns line up ("  Build · Agent step"). The marks are part of the words.
/// A word longer than the line (a test name, `Shares_the_list_with_a_friend_number_2`) breaks onto the next line, so a
/// diff on a phone keeps every word inside its box.
/// In a test it is the group "Diff": `Assert.Visible("+ Performance review · Gate", within: "Diff")`.
/// e.g. `DiffLines(["  Build · Agent step", "− Performance review · Advisory", "+ Performance review · Gate"])`
[Composable]
component DiffLines(List<string> lines, string label = "Diff") {
  render {
    Stack(gap: 0, fontFamily: Font.KeyFace, fontSize: FontSize.Label, lineHeight: "1.7", borderW: 1, border: Colors.SoftLine, rounded: Radius.Control,
          overflow: Overflow.Hidden, role: UiRole.Group, label: label) {
      foreach (var line in lines) {
        if (line.StartsWith("+")) {
          Text(line, py: "2px", px: "10px", bg: Colors.OkTint, color: Colors.OkInk, whiteSpace: WhiteSpace.PreWrap, wordBreak: WordBreak.BreakWord, minW: "0");
        } else if (line.StartsWith("−") || line.StartsWith("-")) {
          Text(line, py: "2px", px: "10px", bg: Colors.BadTint, color: Colors.BadInk, whiteSpace: WhiteSpace.PreWrap, wordBreak: WordBreak.BreakWord, minW: "0");
        } else {
          Text(line, py: "2px", px: "10px", color: Colors.OnSurface, whiteSpace: WhiteSpace.PreWrap, wordBreak: WordBreak.BreakWord, minW: "0");
        }
      }
    }
  }
}
