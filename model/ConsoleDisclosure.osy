namespace Osysharp.Look;

/// The console's "› Details" outside a table (a phone card's "Where it is enforced", a panel's "How a limit holds"): the
/// board's grey chevron and `summary` 12.5/500 in text-2 as ONE press that says `aria-expanded`, and under it, 8 px down
/// while open, its body (the block) 12.5/1.5 in text-2. Starts shut; `open` starts it open. Read as `label`, else the
/// summary. A table row's detail is not this: it is `ConsoleTableRow(detail:)`, a row of its own under the row.
/// In a test it is pressed by its summary: `Ui.Click("Where it is enforced")`.
[Composable]
component ConsoleDisclosure(string summary, string label = "", bool open = false) {
  bool flipped = false;
  action Flip() { flipped = !flipped; }
  render {
    var shown = open != flipped;
    Stack(gap: 0, minW: "0", align: Align.Start) {
      ConsoleDisclosurePress(summary, label != "" ? label : summary, shown, Flip);
      if (shown) {
        Stack(gap: "6px", mt: "8px", fontSize: FontSize.ConsoleSmall, color: Colors.ConsoleText2, lineHeight: "1.5", minW: "0", alignSelf: AlignSelf.Stretch) { Slot; }
      }
    }
  }
}

/// `ConsoleDisclosure`'s press: the chevron and the words, text on hover, the ring on keyboard focus. On a desk it is as
/// tall as its words (a line of text, as the v3 `Disclosure`, not a 30 px console button); on a phone at least 24 px, a
/// finger's target.
[Composable, Part]
component ConsoleDisclosurePress(string summary, string label, bool open, Action toggle) {
  variants {
    base {
      Hover { Color = Colors.ConsoleText; }
      Focus { Shadow = Shadow.Ring; }
    }
  }
  render {
    Pressable(onClick: toggle, expanded: open, label: label, display: Display.Flex, align: Align.Center, gap: "4px",
              minH: Viewport.AtLeast(Tablet) ? "0" : "24px",
              fontSize: FontSize.ConsoleSmall, fontWeight: FontWeight.Medium, color: Colors.ConsoleText2, bg: Colors.Transparent, borderW: 0, p: 0,
              rounded: Radius.ConsoleBadgeCorner, cursor: Cursor.Pointer, lineHeight: "normal", textAlign: TextAlign.Left) {
      Box(display: Display.Flex, decorative: true) { Icon(open ? Icons.ChevronDown : Icons.ChevronRight, size: 14); }
      Text(summary);
    }
  }
}
