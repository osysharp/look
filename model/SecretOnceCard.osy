namespace Osysharp.Look;

// A secret shown the one time it can be (a new API key, a signing secret): on no board as such — drawn from
// `DarkTextCard` (orgsettings/EditData "The signed text": JetBrains Mono on Ink, radius 10, `12px 14px`) inside §3's form
// card values, with §3's buttons, and §21's rule that the one consequential action is the only primary.

/// The secret once: a white card in the card line, radius 14, `16px 18px`; `label` 15/600 and "Shown once — copy it now
/// and keep it somewhere safe; it cannot be shown again." 13 Ink 3; the secret in JetBrains Mono 13 on Ink, broken anywhere so
/// it never scrolls; Copy (outlined, "Copied" after) and the one primary "I have stored it" (`onStored`, which should
/// forget the secret). The secret is the card's TEXT only: never its name, a button's name, an address, a title or a
/// log — the group is named by `label`, the buttons "Copy <label>" and "I have stored it".
/// In a test: `Ui.Click("Copy Deploy key")`, `Ui.Click("I have stored it")`; use an obviously fake secret.
[Composable]
component SecretOnceCard(string label, string secret, Action onStored) {
  bool copied = false;
  action Copy() {
    Clipboard.Copy(secret);
    copied = true;
  }
  render {
    Stack(gap: "12px", py: "16px", px: "18px", bg: Colors.Surface, borderW: 1, border: Colors.CardLine, rounded: Radius.Panel, minW: "0", role: UiRole.Group,
          label: label) {
      Stack(gap: "2px") {
        Text(label, fontSize: FontSize.Summary, fontWeight: FontWeight.Semibold, color: Colors.OnSurface, lineHeight: "1.35");
        Text("Shown once — copy it now and keep it somewhere safe; it cannot be shown again.", fontSize: FontSize.Label, color: Colors.Ink3,
             lineHeight: "1.45");
      }
      Box(bg: Colors.OnSurface, color: Colors.Bg, rounded: Radius.Inner, py: "12px", px: "14px", minW: "0") {
        Text(secret, fontFamily: Font.KeyFace, fontSize: FontSize.Label, lineHeight: "1.6", wordBreak: WordBreak.BreakAll, userSelect: UserSelect.All);
      }
      Row(gap: "8px", align: Align.Center, wrap: Wrapping.Wrap, justify: Justify.End) {
        LookButton(copied ? "Copied" : "Copy", Copy, small: true, name: "Copy " + label);
        LookButton("I have stored it", onStored, kind: ButtonKind.Primary, small: true);
      }
    }
  }
}
