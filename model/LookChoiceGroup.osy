namespace Osysharp.Look;

// The board's radio (Components §22 "Checkbox, switch, radio": a 20 px ring, 2 px, the accent's with a 10 px dot when
// chosen, Ink 3's when not, 14/400 words 8 after it, at least 32 high) and, where each option carries a second line, §21's
// option rows ("30 days, then delete" over "Matches patient-data retention …": a 20 px column for the ring, 15/600 over
// 13 Ink 3, `10px 12px` in the soft line at radius 10, the chosen one in the accent's line on the accent wash).

/// One of a few, chosen: `value` a two-way `Binding<T>` over an enum, its options `options` (every member by default), each
/// worded by its `[Label]`; `detail` gives an option its second line (a role and what it carries) and draws the options as
/// §21's rows. `label` heads the group 13/600 (`inRow`: a `FieldRow` draws it) and names it; `help` a 12 px Ink 3 line under.
/// The group is one stop for Tab: ↑/↓ (or ←/→) move the lit option, Space or Enter chooses it, Home/End go to the ends; a
/// press chooses at once. `onChanged` runs after the choice is written.
/// In a test: `Ui.Click("Editor")`, `Assert.Checked("Editor", true)`, or Tab to the group and `Ui.Press("ArrowDown")`, `Ui.Press(" ")`.
[Composable]
component LookChoiceGroup<T>(string label, Binding<T> value, T[] options = T.Members, Func<T, string>? detail = null, string help = "",
                             bool inRow = false, bool disabled = false, Action? onChanged = null) {
  int at = -1;

  int IndexOf(T m) {
    int i = 0;
    int found = 0;
    foreach (var o in options) {
      if (o == m) { found = i; }
      i = i + 1;
    }
    return found;
  }
  int Lit() { return at < 0 ? IndexOf(value) : at; }
  action Choose(T m) {
    if (disabled) { return; }
    value = m;
    if (onChanged != null) { onChanged(); }
  }
  // A press: chosen, and no option lit (the ring is the keyboard's).
  action Pick(T m) {
    at = -1;
    Choose(m);
  }
  action ChooseLit() {
    int i = 0;
    foreach (var m in options) {
      if (i == Lit()) { Choose(m); }
      i = i + 1;
    }
  }
  action Key(string name) {
    if (disabled) { return; }
    var key = name.Replace("Arrow", "");
    var lit = Lit();
    if (key == "Down" || key == "Right") {
      at = lit < options.Count - 1 ? lit + 1 : 0;
    } else if (key == "Up" || key == "Left") {
      at = lit > 0 ? lit - 1 : options.Count - 1;
    } else if (key == "Home") {
      at = 0;
    } else if (key == "End") {
      at = options.Count - 1;
    } else if (key == "Space" || key == "Enter") {
      ChooseLit();
    }
  }

  render {
    Stack(gap: "6px", minW: "0") {
      if (!inRow) {
        Text(label, fontSize: FontSize.Label, fontWeight: FontWeight.Semibold, color: Colors.OnSurface, lineHeight: "normal", decorative: true);
      }
      Stack(role: UiRole.RadioGroup, label: label, keys: [Up, Down, Left, Right, Space, Enter, Home, End], onKeyDown: Key, gap: detail != null ? "8px" : "2px",
            rounded: Radius.Control, minW: "0") {
        foreach (var m in options) {
          // A Box, not a Pressable: the group is the one Tab stop (a Pressable is one each), and its keys move between them.
          Box(onClick: () => Pick(m), role: UiRole.Radio, checked: m == value, label: m.Label, w: "100%") {
            LookChoiceRow(m.Label, detail != null ? detail(m) : "", m == value, at >= 0 && IndexOf(m) == at, detail != null, disabled);
          }
        }
      }
      if (help != "") {
        Text(help, fontSize: FontSize.Caption, color: Colors.Ink3, lineHeight: "normal");
      }
    }
  }
}
