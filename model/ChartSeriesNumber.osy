namespace Osysharp.Look;

/// The series colour (`LookSeries1`…`LookSeries7`) a bar chart gives its `index`th series (0 first), MS2b: the accent, then its
/// lightest shade, then a grey, so two or three series stay apart in light and dark; then the remaining shades and greys.
internal int ChartSeriesNumber(int index) {
  var order = new List<int> { 1, 3, 5, 2, 4, 6, 7 };
  return order[index % 7];
}
