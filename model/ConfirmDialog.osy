namespace Osysharp.Look;

/// A plain "are you sure?" over a dimmed page: a modal (the keyboard goes to it and back; Escape or a press outside is
/// Cancel), centred, 440 wide at most 94 %, white, radius 14, `20px 22px`, the dialog's shadow (§14's impact dialog);
/// `title` 18/700, `text` 14/1.5 Ink 2, then the actions on the right: `cancelLabel` outlined and `confirmLabel` the
/// primary — or, with `danger`, the bad dot filled with white words: the ONLY red filled button of the look. Render it
/// while the page asks (`if (asking) { ConfirmDialog(…); }`).
/// `busy`: the page's action is running (bind it to the action: `busy: Retire.Pending`) — the confirm button is disabled
/// and says so until it returns, so a second press cannot reach the action. It is also disabled while any action is in
/// flight (`Pending.Any`), so a press straight through needs nothing.
/// It never grows past 90 % of the window: the title stays on top, the reason and the actions at the bottom, and the
/// text and the body scroll between them — a long list of what it touches cannot push the confirm button off screen.
/// An empty `confirmLabel` draws no confirm button: the dialog only shows, and `cancelLabel` ("Close") ends it.
/// In a test: `Assert.Dialog("Retire host-3?")`, `Ui.Click("Retire host-3", within: "Retire host-3?")` or `Ui.Click("Cancel")`.
[Composable]
/// The block is the body, under `text` (a list of what it touches, an `InlineMessage`). `reasonLabel` with `reason` asks
/// for a reason in a text area under the body (the page's own `Binding<string>`); `reasonPlaceholder` is an example reason
/// in it while it is empty ("The customer confirmed the data is not needed"); `reasonRequired`: the confirm button stays
/// off — "Say why first." — until something is typed.
/// e.g. `ConfirmDialog("Revoke key-7?", "", "Revoke", Revoke, Cancel, danger: true, reasonLabel: "Why (required)", reason: why, reasonRequired: true) { … }`
[Composable]
component ConfirmDialog(string title, string text, string confirmLabel, Action onConfirm, Action onCancel, bool danger = false,
                        string cancelLabel = "Cancel", bool busy = false, string reasonLabel = "", Binding<string>? reason = null,
                        bool reasonRequired = false, string busyLabel = "", string busySaid = "", bool canConfirm = true,
                        string reasonPlaceholder = "") {
  DateTime? busyFrom = null;
  bool Wanting() { return reasonRequired && reason != null && reason.Trim() == ""; }
  bool confirming = false;
  // The confirm is the dialog's own action handing on to the page's, so the dialog knows, with nothing from the page,
  // that what it started runs (pressed, and something in flight: a dialog is modal) and when it began (the status line).
  action Confirm() {
    confirming = true;
    busyFrom = DateTime.UtcNow;
    onConfirm();
  }
  on change {
    if (!Pending.Any) {
      confirming = false;
    }
  }
  // While it runs nothing ends the dialog: Escape and a press outside reach this, which does nothing.
  action Stay() { }
  render {
    Box {
      Scrim((busy || confirming && Pending.Any) ? Stay : onCancel);
      Box(position: Position.Fixed, top: "0", left: "0", right: "0", bottom: "0", z: ZIndex.Modal, display: Display.Flex, align: Align.Center,
          justify: Justify.Center, pointerEvents: PointerEvents.None) {
        // The head and the actions stay in view; only the text and the body between them scroll (a long list of what
        // it touches), so the confirm button is on screen without scrolling anything.
        Stack(role: UiRole.ModalDialog, label: title, gap: "12px", w: "440px", maxW: "94%", maxH: "90dvh", overflowY: Overflow.Hidden, py: "20px",
              px: "22px", bg: Colors.Surface, color: Colors.OnSurface, rounded: Radius.Panel, shadow: Shadow.Dialog, pointerEvents: PointerEvents.Auto,
              onEscape: (busy || confirming && Pending.Any) ? Stay : onCancel) {
          Text(title, role: UiRole.Heading, level: 2, fontSize: FontSize.SectionTitle, fontWeight: FontWeight.Heavy, lineHeight: "1.3", shrink: 0);
          Stack(gap: "12px", minH: "0", shrink: 1, overflowY: Overflow.Auto, scrollbarWidth: ScrollbarWidth.Thin) {
            if (text != "") {
              Text(text, fontSize: FontSize.Body, color: Colors.Ink2, lineHeight: "1.5");
            }
            Slot;
          }
          if (busySaid != "" && (busy || confirming && Pending.Any) && busyFrom != null && DateTime.UtcNow >= busyFrom!.Value.AddSeconds(1)) {
            Text(busySaid, fontSize: FontSize.Label, color: Colors.Ink3, lineHeight: "1.45", shrink: 0, role: UiRole.Status);
          }
          if (reasonLabel != "" && reason != null) {
            Box(shrink: 0) { LookTextArea(reasonLabel, reason, h: "72px", placeholder: reasonPlaceholder); }
          }
          Row(gap: "8px", justify: Justify.End, wrap: Wrapping.Wrap, pt: "4px", shrink: 0) {
            LookButton(cancelLabel, onCancel, disabled: (busy || confirming && Pending.Any), whenDenied: (busy || confirming && Pending.Any) ? "Wait for it to finish." : "");
            if (confirmLabel != "" && danger) {
              ConfirmDangerButton(confirmLabel, Confirm, busy: (busy || confirming && Pending.Any), wanting: Wanting(), busyLabel: busyLabel, off: !canConfirm);
            } else if (confirmLabel != "") {
              LookButton(confirmLabel, Confirm, kind: ButtonKind.Primary, disabled: Wanting() || !canConfirm, whenDenied: Wanting() ? "Say why first." : "",
                         busy: (busy || confirming && Pending.Any), busyLabel: busyLabel);
            }
          }
        }
      }
    }
  }
}

/// The confirmation's destructive action: white on the bad dot, `10px 16px`, radius 8, 14/600 — kept here so no page
/// can draw a red filled button outside a confirmation. While its action runs it is disabled and says so (busy, a
/// half-tone red, the default cursor), so a slow action pressed twice runs once.
[Composable, Part]
component ConfirmDangerButton(string label, Action onPress, bool busy = false, bool wanting = false, string busyLabel = "", bool off = false) {
  bool pressed = false;
  action Press() {
    pressed = true;
    onPress();
  }
  on change {
    if (!Pending.Any) {
      pressed = false;
    }
  }
  variants {
    base {
      Display = Display.InlineFlex;
      MinH = "44px";
      Py = "10px";
      Px = "16px";
      Rounded = Radius.Control;
      BorderW = 1;
      BorderStyle = BorderStyle.Solid;
      Border = Colors.BadDot;
      Bg = Colors.BadDot;
      Color = Colors.OnPrimary;
      FontFamily = Font.Sans;
      FontSize = FontSize.Body;
      FontWeight = FontWeight.Semibold;
      LineHeight = "normal";
      WhiteSpace = WhiteSpace.Nowrap;
      Cursor = Cursor.Pointer;
      Hover {
        Bg = Colors.BadInk;
        Border = Colors.BadInk;
      }
      Focus { Shadow = Shadow.Ring; }
      Disabled {
        Opacity = "0.6";
        Cursor = Cursor.Default;
      }
    }
    // Busy keeps its red, dimmed a little (a plain disabled one stays the half-tone).
    busy {
      Opacity = "0.85";
      Disabled {
        Opacity = "0.85";
        Hover {
          Bg = Colors.BadDot;
          Border = Colors.BadDot;
        }
      }
    }
  }
  // The press goes straight to the action (so the press IS the action: the platform marks it busy and its failure is the
  // press's), and the button is disabled the instant the page says it is busy or anything is in flight — not only after
  // the platform's spinner, which waits 200 ms — so a second press cannot reach the action. A confirmation is modal:
  // nothing else on the page runs while it asks.
  render {
    // `wanting`: the dialog's required reason is still empty — off, and it says what it waits for.
    // Busy, it shows `busyLabel` ("Working…" without one) and says it through a polite live region; its name stays
    // `label`. The spinner is the platform's own (a press waiting on the server for more than 200 ms), not drawn here.
    Pressable(onClick: Press, disabled: (busy || pressed && Pending.Any) || wanting || off || Pending.Any, whenDenied: wanting ? "Say why first." : ((busy || pressed && Pending.Any) || Pending.Any ? "Working on it…" : ""), label: label,
              align: Align.Center, justify: Justify.Center, gap: "8px") {
      if ((busy || pressed && Pending.Any)) {
        Text(BusySaid(busyLabel));
        BusyAnnounce(BusySaid(busyLabel));
      } else {
        Text(label);
      }
    }
  }
}
