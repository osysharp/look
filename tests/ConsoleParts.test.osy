// The console parts LC2 added (the gap list G6–G17 of the Admin console plan) at /dev/console-parts, read by their
// words and photographed at 1440 and 390, light and dark; the token bridge (G14) read through OsyrinV3's tokens.

using Osysharp.Look;
using OsyrinLookTests;

[Test]
void The_v3_tokens_carry_the_console_values() {
  Assert.Token("Colors.Bg", "#F4F3F0");
  Assert.Token("Colors.Surface", "#FFFFFF");
  Assert.Token("Colors.Border", "#E2E0DA");
  Assert.Token("Colors.Primary", "#3730A3");
  Assert.Token("Colors.Ink3", "#5F5C57");
  Assert.Token("Radius.Panel", "6px");
  Assert.Token("Radius.Control", "5px");
  Assert.Token("Radius.Chip", "4px");
  Assert.Token("FontSize.Body", "13px");
  Assert.Font("JetBrains Mono");
  Ui.Viewport(1440);
  Ui.Visit("/dev/components");
  Ui.Shot("lc2-components-1440");
  Ui.Theme("dark");
  Ui.Shot("lc2-components-dark-1440");
}

// The kit's settings controls wear the console's settings panel (S1): a white card on the console border with 6 px
// corners, 13 px names in the console ink, help in Ink 3, the indigo track for a switch that is on, 30 px boxes.
[Test]
void The_kit_setting_controls_wear_the_console_values() {
  Assert.Token("Colors.SettingsCardBg", "#FFFFFF");
  Assert.Token("Colors.SettingsCardLine", "#E2E0DA");
  Assert.Token("Colors.SettingHelpInk", "#5F5C57");
  Assert.Token("Colors.SettingSwitchOn", "#3730A3");
  Assert.Token("Radius.SettingsCard", "6px");
  Assert.Token("FontSize.SettingName", "13px");
  Ui.Viewport(1440);
  Ui.Visit("/dev/components");
  Assert.Disabled("Only allowed hosts");
  Assert.Visible("Set for Patient Portal", within: "Idle after");
  Assert.Visible("Always on", within: "Audit trail");
  Ui.Shot("S1-kit-settings-1440", within: "Lane settings");
  Ui.Theme("dark");
  Ui.Shot("S1-kit-settings-dark-1440", within: "Lane settings");
  Ui.Theme("light");
  Ui.Viewport(390);
  Ui.Visit("/dev/components");
  Ui.Shot("S1-kit-settings-390", within: "Lane settings");
}

[Test]
void A_console_button_comes_as_danger_and_as_a_link() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Clickable("Revoke…");
  Assert.Clickable("Give up the zone");
  Assert.Readable("Revoke…");
  Assert.Readable("Give up the zone");
  Assert.SameHeight("Revoke…", "Save");
  Assert.SameHeight("New organization", "Save");
  Ui.Shot("lc2-buttons-1440", within: "Button kinds");
  Ui.Theme("dark");
  Assert.Readable("Give up the zone");
  Ui.Shot("lc2-buttons-dark-1440", within: "Button kinds");
  Ui.Theme("light");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Open the plan", "Cancel");
  Ui.Shot("lc2-buttons-390", within: "Button kinds");
  Ui.Click("New organization");
  Assert.OnPage("/dev/console");
}

// A console filter is a row of buttons: as tall as a console button beside it, 30 px on a desk and 44 px on a phone
// (spec "Buttons"), its words the button's.
[Test]
void A_console_filter_is_as_tall_as_a_console_button() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Firing", "Save");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Firing", "Cancel");
}

// A dropdown in a console form is the console's control (7g b, admin-finish-look 20): as tall as a console button on a
// desk — 30 px, not the look's 44 px field — and the 44 px tap target on a phone.
[Test]
void A_console_dropdown_is_as_tall_as_a_console_button() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Runs when", "Save");
  Assert.Visible("A dropdown in a console form is the console's control.", within: "Form");
  Ui.Shot("console-dropdown-1440");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Runs when", "Cancel");
}

// A date and a number in a console form are the console's control too (7i, admin-finish-look 22): as tall as a console
// button on a desk and the 44 px tap target on a phone; the date still opens the month calendar `Ui.Fill` walks.
[Test]
void A_console_date_and_number_are_as_tall_as_a_console_button() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Starts on", "Save");
  Assert.SameHeight("A console number's box", "Save");
  Ui.Fill("Starts on", "2026-12-03");
  Assert.Visible("3 Dec 2026", within: "Form");
  Ui.Fill("Keep for", "14");
  Ui.Shot("console-date-number-1440");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Starts on", "Cancel");
  Assert.SameHeight("A console number's box", "Cancel");
}

// A console date bound to an entity's field shows the field's refused-save sentence under itself, as DatePicker does
// (field-messages-in-kit) — another booking already has the day, which only the server knows; the page has no validation code (7i, admin-finish-look 22, the reviewer's finding).
[Test]
void A_console_date_says_under_itself_why_its_save_was_refused() {
  new ConsoleBooking { Name = "Winter fair", Day = new DateOnly(2026, 12, 10) };
  var booking = new ConsoleBooking { Name = "Spring fair", Day = new DateOnly(2026, 12, 3) };
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-date-save/" + booking.Id);
  Assert.Visible("3 Dec 2026");
  Ui.Fill("Day", "2026-12-10");
  Ui.Click("Save");
  Assert.TextIs("Another booking is on that day.");
}

// A badge longer than its cell stays in the cell (B-Organizations: the plan's long name ran into the next column).
[Test]
void A_long_console_badge_stays_inside_its_cell() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Inside("Internal organisation (unlimited)", "Narrow cell");
  // …and beside a long name in a row (a phone's tap row) the badge keeps its words whole: the name wraps instead.
  Assert.FitsOn("Acknowledged");
}

// A table narrower than its columns scrolls sideways inside its panel (spec "wrap the table in overflow-x: auto"); its
// flexible column keeps a readable width instead of being crushed to a word a line beside the fixed ones.
[Test]
void A_narrow_console_table_scrolls_rather_than_crushing_its_name_column() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Wider("Incident", "Stage");
  Assert.NoOverflow();
}

// A word longer than a wrapping cell (an identifier, no spaces) breaks inside the cell, never running past it (Alert
// causes at 1024: "MailSendCeilingReached" 16 px past its column).
[Test]
void A_long_word_in_a_wrapping_cell_stays_inside_its_column() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.FitsOn("MailSendCeilingReached");
}

[Test]
void A_console_field_shows_its_label_its_help_and_its_error() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Visible("Lower-case letters, digits and dashes.", within: "Slug");
  Assert.Visible("A name is required.", within: "Display name");
  Assert.Hidden("Shown to the organization's owners.", within: "Display name");
  Ui.Fill("Display name", "Northwind Health");
  Assert.Value("Display name", "Northwind Health");
  Ui.Fill("Why", "Moved to the new plan.");
  Assert.Value("Why", "Moved to the new plan.");
  Ui.Shot("lc2-form-1440", within: "Form");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.NoOverflow();
  Ui.Shot("lc2-form-390", within: "Form");
}

[Test]
void The_console_states_say_empty_loading_failed_read_only_and_not_found() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Visible("A release appears here when the first build of a line is published.", within: "No releases yet");
  Assert.Visible("Open the lines", within: "No releases yet");
  Assert.Inside("Loading hosts", "Loading panel");
  Assert.Visible("The host has not answered for 4 minutes. The lanes it reported last are kept.", within: "Could not load the lanes on nw-mini-ios");
  Assert.Visible("Try again", within: "Could not load the lanes on nw-mini-ios");
  Assert.Visible("Who are the admins?", within: "You can view this policy. To change it, ask an org admin.");
  Assert.Readable("You can view this policy. To change it, ask an org admin.");
  Ui.Shot("lc2-states-1440", within: "Console parts");
  Ui.Theme("dark");
  Ui.Shot("lc2-states-dark-1440", within: "Console parts");
  Ui.Theme("light");
  Ui.Visit("/dev/console-parts/missing");
  Assert.Visible("Not found", within: "There is no organization called acme");
  Assert.Visible("It may have been renamed or closed. Every organization you can see is in the list.");
  Ui.Shot("lc2-page-state-1440");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts/missing");
  Assert.NoOverflow();
  Ui.Shot("lc2-page-state-390");
  Ui.Click("All organizations");
  Assert.OnPage("/dev/console");
}

[Test]
void An_inline_message_says_saved_to_know_or_refused() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Visible("The plan is saved.", within: "Saved");
  Assert.Visible("Undo", within: "Saved");
  Assert.Visible("Changes take effect on the next build.");
  Assert.Visible("Another owner changed the plan while you edited it.", within: "Not saved");
  Assert.Readable("The plan is saved.");
  Assert.Readable("Changes take effect on the next build.");
  Assert.Readable("Another owner changed the plan while you edited it.");
  Ui.Shot("lc2-messages-1440", within: "Messages");
  Ui.Theme("dark");
  Assert.Readable("The plan is saved.");
  Assert.Readable("Changes take effect on the next build.");
  Assert.Readable("Another owner changed the plan while you edited it.");
  Ui.Shot("lc2-messages-dark-1440", within: "Messages");
  Ui.Theme("light");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.NoOverflow();
  Ui.Shot("lc2-messages-390", within: "Messages");
}

[Test]
void A_console_meter_says_its_amount_and_turns_at_its_line() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Visible("312 of 500 GB", within: "Storage: 312 of 500 GB");
  Assert.Visible("430 of 500 · over the warning line", within: "Builds this month: 430 of 500 · over the warning line");
  Assert.Visible("12 of 12", within: "Seats: 12 of 12");
