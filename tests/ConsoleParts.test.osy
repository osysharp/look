  Ui.Shot("lc2-meters-1440", within: "Meters");
  Ui.Theme("dark");
  Ui.Shot("lc2-meters-dark-1440", within: "Meters");
  Ui.Theme("light");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Ui.Shot("lc2-meters-390", within: "Meters");
}

[Test]
void A_console_panel_has_a_foot_and_a_chart_card_its_legend_axis_and_empty_state() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Visible("View all organizations ›", within: "Panel with a foot");
  Assert.Below("View all organizations ›", "Osyrin Preview");
  Assert.Visible("Bundle", within: "Legend");
  Assert.Visible("Assets", within: "Legend");
  Assert.LeftOf("20 builds ago", "newest");
  Assert.Visible("Costs appear the day after the first invoice is imported.", within: "No costs imported yet");
  Assert.Hidden("Bundle", within: "Cost by day");
  Ui.Shot("lc2-panel-foot-1440", within: "Panel with a foot");
  Ui.Shot("lc2-chart-1440", within: "Size over time");
  Ui.Shot("lc2-chart-empty-1440", within: "Cost by day");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.NoOverflow();
  Ui.Shot("lc2-panel-foot-390", within: "Panel with a foot");
  Ui.Shot("lc2-chart-390", within: "Size over time");
  Ui.Click("View all organizations ›");
  Assert.OnPage("/dev/console");
}

[Test]
void The_signed_out_frame_reads_on_the_console_tokens() {
  Assert.Font("Inter");
  Ui.Viewport(1440);
  Ui.Visit("/dev/signed-out");
  Assert.Readable("Run your apps.");
  Assert.Readable("With the address your organisation invited.");
  Ui.Shot("lc2-signed-out-1440");
  Ui.Theme("dark");
  Assert.Readable("Run your apps.");
  Ui.Shot("lc2-signed-out-dark-1440");
  Ui.Theme("light");
  Ui.Viewport(390);
  Ui.Visit("/dev/signed-out");
  Assert.NoOverflow();
  Ui.Shot("lc2-signed-out-390");
}

// SH1: the Ui kit's base tokens carry the console's values, so a kit's page (the user manager's People, API keys) stands
// in the console shell with the console's tables, fields and buttons: the line of a card, the meta text, the corners,
// and a kit button as high as a console button, 30 on a tablet and wider, 44 on a phone.
[Test]
void The_kits_base_tokens_carry_the_console_values() {
  Assert.Token("Colors.CardLine", "#E2E0DA");
  Assert.Token("Colors.MetaText", "#5F5C57");
  Assert.Token("Radius.Sm", "4px");
  Assert.Token("Radius.Md", "5px");
  Assert.Token("Radius.Lg", "6px");
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Invite someone", "Console twin");
  Assert.SameHeight("Kit cancel", "Console twin");
  Ui.Shot("sh1-kit-controls-1440", within: "Kit controls");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("Invite someone", "Console twin");
  Ui.Shot("sh1-kit-controls-390", within: "Kit controls");
}

// A plan key is a chip in its level's colours (WS1): a saga's key is white on the accent, so it reads only while the chip
// keeps its ground — a chip that lost its level's colours draws white words on the white panel, in a tree row as alone.
[Test]
void A_plan_key_keeps_its_levels_colours_in_a_tree_row_and_alone() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Ui.Within("Plan keys") {
    Assert.Visible("FOUNDRY-1");
    Assert.Readable("FOUNDRY-1");
    Assert.Readable("FOUNDRY-2");
    Assert.Readable("FOUNDRY-3");
  }
}

// An amount in a console form is the console's control (AFL23-2, admin-finish-look 24): as tall as a console button on a desk and
// the 44 px tap target on a phone, its prefix and unit inside the box, a value out of range refused under it in words.
[Test]
void A_console_amount_is_as_tall_as_a_console_button_and_refuses_out_of_range() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("A console amount's box", "Save");
  Assert.Visible("An amount: a decimal, its unit inside the box.", within: "Form");
  Ui.Fill("Daily cap", "150.5");
  Assert.Visible("At most 100 a day.", within: "Form");
  Assert.Hidden("An amount: a decimal, its unit inside the box.");
  Ui.Shot("console-amount-refused-1440");
  Ui.Fill("Daily cap", "12.75");
  Assert.Hidden("At most 100 a day.");
  Assert.Value("Daily cap", "12.75");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.SameHeight("A console amount's box", "Cancel");
}

// A console field's help or refusal line is what a screen reader hears after the input's name — tied to the input, not only drawn
// beside it (AFL24-2, admin-finish-look 26): the text input, the text area, the amount (in its field and in a row) and the console number.
[Test]
void A_console_fields_line_is_its_inputs_description() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.Described("Slug", "Lower-case letters, digits and dashes.");
  Assert.Described("Display name", "A name is required.");
  Assert.Described("Why", "Shown to the organization's owners.");
  Assert.Described("Daily cap", "An amount: a decimal, its unit inside the box.");
  Ui.Fill("Daily cap", "150.5");
  Assert.Described("Daily cap", "At most 100 a day.");
  Ui.Fill("Weekly cap", "-1");
  Assert.Described("Weekly cap", "At least 0 tokens.");
  Ui.Fill("Keep for", "0");
  Assert.Described("Keep for", "At least 1 days.");
}

// A console button the caller may not press is drawn refused in the console's own face — as tall as its neighbours — and says
// why to a screen reader and a test (AFL25: the Look `ActionButton` was the only refused button, so a console page fell back
// to the Look face for it).
[Test]
void A_refused_console_button_says_why_in_the_consoles_face() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.DisabledBecause("Rename", "Only an owner renames it.");
  Assert.SameHeight("Rename", "Save");
  Ui.Viewport(390);
  Ui.Visit("/dev/console-parts");
  Assert.DisabledBecause("Rename", "Only an owner renames it.");
  Assert.SameHeight("Rename", "Cancel");
}

// A refused button that is also busy stays refused and says why (AFL25-5): busy is about a press, and the reader may not press it.
[Test]
void A_refused_busy_console_button_keeps_its_reason() {
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-parts");
  Assert.DisabledBecause("Archive", "Only an owner archives it.");
  Assert.Hidden("Archiving…");
}
