namespace OsyrinLookTests;

using Osysharp.Look;

/// The signed-out frame with a headline, a lede, a form and a box under the form, as the platform's Admin draws its
/// sign-in page.
[Route("/dev/signed-out")]
[AllowAnonymous]
[Title("Sign in")]
[Render(CSR)]
component SignedOutGalleryPage() {
  string address = "";
  string password = "";
  string said = "";
  action SignIn() { said = "Signing in as " + address; }
  render {
    LookSignedOutFrame(
      "Sign in",
      "Run your apps.\nSee every change.",
      Textures.SignedOutHero,
      "Osyrin Admin",
      lede: "The platform's own console: organisations, plans, hosts and the releases they run.",
      sub: "With the address your organisation invited."
    ) {
      Stack(gap: 4) {
        LookField("Email") {
          Input(value: address, label: "Email", w: "100%", minH: "44px", px: "12px", rounded: Radius.Control, borderW: 1,
                border: Colors.SignedOutOutline, bg: Colors.SignedOutField);
        }
        LookField("Password") {
          Input(value: password, label: "Password", type: "password", w: "100%", minH: "44px", px: "12px", rounded: Radius.Control,
                borderW: 1, border: Colors.SignedOutOutline, bg: Colors.SignedOutField);
        }
        LookButton("Sign in", SignIn, kind: ButtonKind.Primary);
        if (said != "") { Text(said); }
      }
      slot below {
        Stack(gap: 2, p: 5, rounded: Radius.Inner, borderW: 1, border: Colors.SignedOutOutline, label: "Run it yourself") {
          Text("Run it yourself", fontWeight: FontWeight.Semibold);
          Text("The platform installs on your own servers with one command.", color: Colors.TextMuted);
        }
      }
    }
  }
}

/// The signed-out frame saying what the front page's hero says: an eyebrow, a headline whose second line is in the
/// artwork's second ink, a lede and a tagline — as Admin's `/apply` draws it.
[Route("/dev/signed-out/hero")]
[AllowAnonymous]
[Title("Apply for the beta")]
[Render(CSR)]
component SignedOutHeroGalleryPage() {
  string address = "";
  string building = "";
  string said = "";
  action Apply() { said = "A code is on its way to " + address; }
  render {
    LookSignedOutFrame(
      "Apply for the beta",
      "Every team can build with AI.",
      Textures.SignedOutHero,
      "Osyrin",
      eyebrow: "Private beta",
      headlineAccent: "Every app follows your rules.",
      lede: "We're letting teams in a few at a time.",
      tagline: "Software you own.",
      taglineAccent: "Run for you.",
      sub: "An address and a sentence about what you build."
    ) {
      Stack(gap: 4) {
        LookInput("Email", address, type: "email", placeholder: "you@company.com");
        LookTextArea("What you want to build", building, h: "112px");
        LookButton("Join the beta", Apply, kind: ButtonKind.Primary, wide: true);
        if (said != "") { Text(said); }
      }
    }
  }
}
