namespace OsyrinLookTests;

using Osysharp.Look;

// The one-time secret card, with an obviously fake secret. In the gallery and alone at /dev/controls/secret.

/// The gallery's "A secret, shown once" section.
[Composable]
component GallerySecret() {
  render {
    Stack(gap: "16px", label: "A secret, shown once") {
      H2("A secret, shown once");
      Caption("A new key shown the one time it can be: copy it, then say it is stored and it is gone from the page.");
      SecretSample();
    }
  }
}

/// A made key, shown until "I have stored it" forgets it.
[Composable]
component SecretSample() {
  string secret = "fake_sk_test_0000000000000000_NOT_A_REAL_KEY_example";
  action Stored() { secret = ""; }
  render {
    Stack(gap: "12px", maxW: "560px", minW: "0") {
      if (secret != "") {
        SecretOnceCard("Deploy key", secret, Stored);
      } else {
        InlineMessage("The key is stored; only its last four characters are kept here.", LookTone.Ok, lead: "Done.");
      }
    }
  }
}

/// The secret card alone.
[Route("/dev/controls/secret")]
[AllowAnonymous]
[Title("A secret, shown once")]
[Render(CSR)]
component SecretPage() {
  render { ControlsFrame("A secret, shown once") { SecretSample(); } }
}
