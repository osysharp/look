namespace OsyrinLookTests;

using Osysharp.Look;

/// Row menus, card actions, hover titles on a last row and empty cards (L1), one under the other.
[Composable]
component RowMenuSamples() {
  render {
    Stack(gap: "16px", minW: "0") {
      RowMenuSample();
      CardActionSample();
      EmptyCardSample();
    }
  }
}
