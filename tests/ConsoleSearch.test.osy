// The console's ⌘K search through an app's own search source (/dev/console-search): `OrganizationSearch` implements
// IConsoleSearchSource, and what it finds shows in the dialog under the source's group.

using Osysharp.Look;
using OsyrinLookTests;

[TestFixture]
void ConsoleOrganizations() {
  new ConsoleOperator { Email = "ops@osyrin.test" };
  new ConsoleOrganization { Slug = "masoli", Name = "Javier's Org" };
  new ConsoleOrganization { Slug = "preview", Name = "Osyrin Preview" };
}

principal Ops => ConsoleOperator.Single(o => o.Email == "ops@osyrin.test");

[Test(ConsoleOrganizations)]
void The_search_shows_what_the_apps_search_source_finds_under_its_group() {
  Ui.SignInAs(Ops);
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-search");
  Ui.Press("Mod+K");
  Ui.Fill("Search the console", "jav");
  Assert.Visible("Javier's Org", within: "Organizations");
  Assert.Visible("masoli", within: "Organizations");
  Assert.Hidden("Osyrin Preview");
  Ui.Fill("Search the console", "preview");
  Assert.Visible("Osyrin Preview", within: "Organizations");
  Assert.Hidden("Javier's Org");
  Ui.Fill("Search the console", "nowhere");
  Assert.Visible("Nothing found for “nowhere”.", within: "Search");
}

// PLATFORM-204 (Foundry FXLOOK §2): a result with every part — kind, key, title, product, badge. On one phone line the
// fixed parts left the title about 15 px and it broke one letter to a line; below Tablet the title has a line of its own.
[TestFixture]
void ConsoleConversations() {
  new ConsoleOperator { Email = "ops@osyrin.test" };
  new ConsoleConversation { Key = "ALPHA-BRD-1-T1", Title = "Should the summary come first?", Product = "ALPHA", State = "Answered" };
  new ConsoleConversation { Key = "ALPHA-BRD-1-T2", Title = "Does the summary go before the open questions and the list of what changed since the last release?",
                            Product = "ALPHA", State = "Waiting" };
}

[Test(ConsoleConversations)]
void A_search_result_wraps_its_title_by_words_on_a_phone_and_a_desktop() {
  Ui.SignInAs(Ops);
  foreach (var width in [390, 1440]) {
    Ui.Viewport(width);
    Ui.Visit("/dev/console-search");
    Ui.Click("Search");
    Ui.Fill("Search the console", "summary");
    Assert.Visible("Should the summary come first?", within: "Conversations");
    Assert.WrapsByWords("Should the summary come first?");
    Assert.WrapsByWords("Does the summary go before the open questions and the list of what changed since the last release?");
    Assert.WrapsByWords("ALPHA-BRD-1-T2 Does the summary go before the open questions and the list of what changed since the last release?");
    Assert.NoOverflow();
    Ui.Shot("search-row-" + width);
    Ui.Press("Escape");
  }
}

[Test(ConsoleOrganizations)]
void Opening_the_search_by_the_shortcut_puts_the_keyboard_in_its_field() {
  Ui.SignInAs(Ops);
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-search");
  Ui.Press("Mod+K");
  Assert.Focused("Search the console");
}

[Test(ConsoleOrganizations)]
void Opening_the_search_by_its_button_puts_the_keyboard_in_its_field() {
  Ui.SignInAs(Ops);
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-search");
  Ui.Click("Search");
  Assert.Focused("Search the console");
}

[Test(ConsoleOrganizations)]
void Escape_closes_the_search_and_gives_the_keyboard_back_to_its_button() {
  Ui.SignInAs(Ops);
  Ui.Viewport(1440);
  Ui.Visit("/dev/console-search");
  Ui.Click("Search");
  Assert.Focused("Search the console");
  Ui.Press("Escape");
  Assert.Hidden("Search the console");
  Assert.Focused("Search");
}
